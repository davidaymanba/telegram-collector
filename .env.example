# Application
TUC_APP_ENV=local
TUC_LOG_LEVEL=INFO
TUC_LOG_FORMAT=json

# Database: use MySQL for local/prod by default. SQLite is acceptable for tests.
TUC_DATABASE_URL=mysql+pymysql://collector:change-me@127.0.0.1:3306/telegram_collector?charset=utf8mb4

# Telegram MTProto credentials from https://my.telegram.org
TUC_TELEGRAM_API_ID=
TUC_TELEGRAM_API_HASH=
TUC_TELEGRAM_SESSION_PATH=secrets/telegram.session
TUC_TELEGRAM_REQUEST_DELAY_SECONDS=1.0
TUC_TELEGRAM_COLLECT_TEXT_MESSAGES=false

# Storage and configuration
TUC_CHANNELS_CONFIG_PATH=config/channels.yaml
TUC_SUBJECTS_CONFIG_PATH=config/subjects.yaml
TUC_STORAGE_ROOT=storage
TUC_INCOMING_STORAGE_DIR=storage/incoming
TUC_PROCESSED_STORAGE_DIR=storage/processed
TUC_UNCLASSIFIED_STORAGE_DIR=storage/unclassified
TUC_LOCK_FILE_PATH=storage/collector.lock

# OCR
TUC_OCR_ENABLED=true
TUC_OCR_LANGUAGE=ara+eng
TUC_MIN_PDF_TEXT_CHARS=120

# Classification
TUC_AI_PROVIDER=none
TUC_OPENAI_API_KEY=
TUC_OPENAI_MODEL=gpt-4.1-mini
TUC_MAX_CLASSIFICATION_CHARS=12000
TUC_CLASSIFICATION_MIN_CONFIDENCE=0.78
TUC_CLASSIFICATION_MIN_EVIDENCE_ITEMS=1
